{
  "name": "life-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && npm run build:server && vite build",
    "build:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "start:server": "tsx server/index.ts",
    "preview": "vite preview",
    "test:tasks": "mkdir -p node_modules/.tmp && esbuild tests/tasks.test.mjs --bundle --platform=node --format=esm --outfile=node_modules/.tmp/tasks.test.mjs && node --test node_modules/.tmp/tasks.test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "lucide-react": "^1.56.0",
    "mongodb": "^6.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
